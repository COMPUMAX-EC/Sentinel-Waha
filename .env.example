# ============================================
# SENTINEL WHATSAPP - CONFIGURATION
# ============================================
# Copy this file to .env and fill with your actual values

# ============================================
# WAHA API CONFIGURATION
# ============================================
WAHA_API_URL=https://waha.compumax.tech
WAHA_API_KEY=your_api_key_here
WAHA_SESSION_NAME=default
WAHA_TIMEOUT=30

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_waha
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis for caching and queues
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# Secret key for JWT and encryption
SECRET_KEY=your_secret_key_here_change_in_production

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features
ENABLE_AUTO_RESPONSE=true
ENABLE_ANALYTICS=true
ENABLE_WEBHOOKS=true
ENABLE_INTENT_CLASSIFICATION=true

# ============================================
# RESPONSE ENGINE SETTINGS
# ============================================
# Humanization delays (in seconds)
RESPONSE_DELAY_MIN=2
RESPONSE_DELAY_MAX=5

# Typing simulation
ENABLE_TYPING_INDICATOR=true
TYPING_SPEED_CHARS_PER_SECOND=40

# Response behavior
MAX_AUTO_RESPONSES_PER_CONVERSATION=3
HUMAN_HANDOFF_AFTER_MINUTES=30

# ============================================
# INTENT CLASSIFICATION
# ============================================
# Thresholds for intent levels
INTENT_HIGH_THRESHOLD=0.8
INTENT_MEDIUM_THRESHOLD=0.5

# Keywords for high intent
HIGH_INTENT_KEYWORDS=precio,costo,pago,comprar,envío,delivery,disponible,stock

# Keywords for low intent (spam)
LOW_INTENT_KEYWORDS=hola,hello,hi,hey,buenos días,buenas tardes

# ============================================
# WEBHOOKS
# ============================================
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_URL=https://your-domain.com/webhooks/waha
WEBHOOK_RETRY_ATTEMPTS=3

# ============================================
# ANALYTICS & MONITORING
# ============================================
# Metrics collection interval (in seconds)
METRICS_COLLECTION_INTERVAL=60

# Dashboard refresh rate (in seconds)
DASHBOARD_REFRESH_RATE=30

# Enable external analytics
ENABLE_GOOGLE_ANALYTICS=false
GOOGLE_ANALYTICS_ID=

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/sentinel.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ============================================
# BUSINESS RULES
# ============================================
# Business hours (24h format)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_TIMEZONE=America/Mexico_City

# Response time targets (in minutes)
TARGET_FIRST_RESPONSE_TIME=5
TARGET_AVERAGE_RESPONSE_TIME=10

# ============================================
# EXTRACTION SETTINGS
# ============================================
# Batch size for historical extraction
EXTRACTION_BATCH_SIZE=100
EXTRACTION_MAX_RETRIES=3

# Date range for initial extraction (YYYY-MM-DD)
EXTRACTION_START_DATE=2024-01-01
EXTRACTION_END_DATE=2026-01-28

# ============================================
# SECURITY
# ============================================
# API rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS settings
CORS_ORIGINS=http://localhost:3000,https://compumax.tech
CORS_ALLOW_CREDENTIALS=true

# ============================================
# NOTIFICATION SETTINGS
# ============================================
# Alerts via WhatsApp
ALERT_PHONE_NUMBER=+525512345678

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
ALERT_EMAIL=alerts@compumax.tech

# ============================================
# ADVANCED SETTINGS
# ============================================
# Machine Learning Model
ML_MODEL_PATH=models/intent_classifier.pkl
ML_MODEL_VERSION=1.0.0
ML_RETRAIN_THRESHOLD_DAYS=30

# Queue settings
QUEUE_MAX_SIZE=1000
QUEUE_WORKER_THREADS=4

# Cache TTL (in seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400
